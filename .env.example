ENVIRONMENT=local
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=pekko-iceberg-sink-local
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
INPUT_TOPICS=events
AUTO_OFFSET_RESET=earliest
SCHEMA_REGISTRY_URL=http://localhost:8081
# RecordNameStrategy requires a JSON Schema "title"; use TopicNameStrategy otherwise.
SCHEMA_REGISTRY_VALUE_SUBJECT_NAME_STRATEGY=io.confluent.kafka.serializers.subject.RecordNameStrategy

# Replace with an AWS bucket before running against Glue/S3.
S3_BUCKET=example-iceberg-bucket
S3_REGION=us-east-1
S3_PATH_PREFIX=data
ICEBERG_DATABASE=default
ICEBERG_TABLE=events
ICEBERG_TABLE_NAME_MODE=static
ICEBERG_PARTITION_FIELDS=event_date,ingest_date
ICEBERG_WAREHOUSE=
ICEBERG_GLUE_ENDPOINT=
ICEBERG_S3_ENDPOINT=
ICEBERG_S3_PATH_STYLE_ACCESS=false

S3_BATCH_SIZE=500
S3_BATCH_MAX_BYTES=67108864
S3_BATCH_WINDOW_SECONDS=30
ICEBERG_COMMIT_INTERVAL_SECONDS=60
KAFKA_COMMIT_MAX_BATCH=500
KAFKA_COMMIT_MAX_INTERVAL_SECONDS=5
CACHE_CAPACITY=1000
